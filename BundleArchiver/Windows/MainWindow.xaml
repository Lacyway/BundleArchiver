<Window x:Class="BundleArchiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BundleArchiver"
        xmlns:mvvm="clr-namespace:BundleArchiver.ViewModels"
        xmlns:conv="clr-namespace:BundleArchiver.Converters"
        mc:Ignorable="d"
        Title="Bundle Archiver" Height="450" Width="800">

    <Window.DataContext>
        <mvvm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:FileSizeConverter x:Key="FileSizeConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListView BorderBrush="DarkGray" ItemsSource="{Binding Mods}"
          Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Mod"
                            DisplayMemberBinding="{Binding Name}"
                            Width="200"/>

                    <GridViewColumn Header="Bundles"
                        DisplayMemberBinding="{Binding BundleFiles.Count}"
                        Width="100"/>

                    <GridViewColumn Header="Size" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalSize, Converter={StaticResource FileSizeConverter}}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Files" Width="345">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Expander Header="Show files">
                                    <ListBox ItemsSource="{Binding BundleFiles}"
                                             MaxHeight="200"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontSize="10"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Expander>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Width="80"
                    Margin="10"
                    Content="Scan"
                    Command="{Binding ScanCommand}">
            </Button>
            <Button Width="80"
                    Margin="10"
                    Content="Start"
                    Command="{Binding StartCommand}">
            </Button>
            <CheckBox Content="Use High Compression"
                      Margin="10"
                      ToolTip="If enabled, the resulting .zip file will be smaller, but the archiving process is slower&#10;&#10;NOTE: Results may vary"
                      IsChecked="{Binding HighCompression}"/>
        </StackPanel>

        <ContentPresenter/>

        <Border Grid.RowSpan="2" Background="#80000000"
            Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Background="#2C2C2C"
                Width="300"
                Padding="16"
                CornerRadius="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding DialogText}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>
                    <Button Content="OK"
                        Width="80"
                        HorizontalAlignment="Right"
                        Command="{Binding CloseDialogCommand}"/>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>
