<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
				xmlns:vm="using:BundleArchiverAvalonia.ViewModels"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
        x:Class="BundleArchiverAvalonia.MessageBox"
				x:DataType="vm:MessageBoxViewModel"
				Width="400" Height="200"
				CanResize="False"
        Title="{Binding WindowTitle}">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="7*"/>
			<RowDefinition Height="3*"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Margin="5" HorizontalAlignment="Center" Width="380" Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center"/>
		<Button Grid.Row="1" Margin="10" HorizontalAlignment="Center" Content="OK" Command="{Binding CloseCommand}"/>
	</Grid>
</Window>
